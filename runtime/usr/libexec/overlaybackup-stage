#!/bin/sh
#
# luci-app-overlaybackup - фоновая распаковка архива для восстановления
#
# Запускается контроллером LuCI сразу после приёма загруженного файла и
# отвязывается от него. Делать распаковку внутри HTTP-запроса нельзя:
# uhttpd убивает CGI-процесс, который за script_timeout (по умолчанию
# 60 секунд) не выдал ответа, а архив overlay на сотни мегабайт на
# процессоре роутера распаковывается минутами. Браузер в этом случае видит
# "Bad Gateway: The process did not produce any response", а распаковка
# обрывается на полпути.
#
# Ход работы виден странице через файлы в рабочем каталоге:
#   working      - PID этого процесса, пока он работает
#   pending      - архив распакован и проверен, подмена на следующей загрузке
#   restore.log  - причина неудачи; первая строка CODE:<код> переводится
#                  страницей, остальное - вывод tar как есть

STAGE_ROOT=/overlay/.overlaybackup
UPLOAD="$STAGE_ROOT/upload.tar.gz"
STAGING="$STAGE_ROOT/staging"
PENDING="$STAGE_ROOT/pending"
WORKING="$STAGE_ROOT/working"
LOGFILE="$STAGE_ROOT/restore.log"
UNPACK_LOG="$STAGE_ROOT/unpack.log"

echo $$ > "$WORKING"

fail() {
	{
		echo "CODE:$1"
		[ -f "$UNPACK_LOG" ] && cat "$UNPACK_LOG"
	} > "$LOGFILE"
	rm -rf "$STAGING"
	rm -f "$UPLOAD" "$UNPACK_LOG" "$WORKING"
	exit 1
}

[ -f "$UPLOAD" ] || fail no_upload

# GNU tar нужен, чтобы перенести метки overlayfs (trusted.overlay.opaque):
# BusyBox tar про расширенные атрибуты не знает и молча их теряет.
GNU_TAR=""
for candidate in /usr/bin/tar /bin/tar /usr/sbin/tar; do
	[ -x "$candidate" ] || continue
	if "$candidate" --version 2>/dev/null | grep -q 'GNU tar'; then
		GNU_TAR="$candidate"
		break
	fi
done

mkdir -p "$STAGING"

if [ -n "$GNU_TAR" ]; then
	"$GNU_TAR" --xattrs --xattrs-include='trusted.overlay.*' --numeric-owner \
		-xzf "$UPLOAD" -C "$STAGING" > "$UNPACK_LOG" 2>&1 || fail unpack_failed
else
	tar -xzf "$UPLOAD" -C "$STAGING" > "$UNPACK_LOG" 2>&1 || fail unpack_failed
fi

rm -f "$UPLOAD" "$UNPACK_LOG"

# Без etc устройство не загрузится, а это чинится только сбросом к заводским.
[ -d "$STAGING/etc" ] || fail no_etc

date '+%Y-%m-%d %H:%M:%S' > "$PENDING"
sync

/etc/init.d/overlaybackup-restore enable 2>/dev/null

rm -f "$WORKING"

# Пауза - чтобы страница, которая сама обновляется каждые несколько секунд,
# успела показать, что архив готов и устройство уходит в перезагрузку.
sleep 5
reboot
